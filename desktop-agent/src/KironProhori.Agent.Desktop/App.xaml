<Application x:Class="KironProhori.Agent.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- =================================================================== -->
        <!-- KIRON PROHORI — DEEP SLATE & EMERALD CYBER-DEFENSE VISUAL SYSTEM    -->
        <!-- Deep Slate Canvas (#0B1120), Elevated Slate Cards (#111827),        -->
        <!-- Subtle Card Borders (#1E293B), Emerald Shield (#10B981),            -->
        <!-- Mint Green Lucide Icons & Links (#34D399), Dark Translucent Pills.  -->
        <!-- =================================================================== -->
        <SolidColorBrush x:Key="AppCanvasBrush" Color="#0B1120" />
        <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#080D1A" />
        <SolidColorBrush x:Key="UtilityBarBackgroundBrush" Color="#080D1A" />
        <SolidColorBrush x:Key="GlassCardBrush" Color="#111827" />
        <SolidColorBrush x:Key="GlassElevatedBrush" Color="#162032" />
        <SolidColorBrush x:Key="GlassBorderBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="GlassHoverBorderBrush" Color="#10B981" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#10B981" />
        <SolidColorBrush x:Key="SafeEmeraldBrush" Color="#10B981" />
        <SolidColorBrush x:Key="OxygenMintBrush" Color="#34D399" />
        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="DangerRedBrush" Color="#F42A41" />

        <!-- Translucent Emerald Card Icon Container: rgba(16, 185, 129, 0.12) & 1px rgba(16, 185, 129, 0.25) -->
        <SolidColorBrush x:Key="TileIconBoxBrush" Color="#1F10B981" />
        <SolidColorBrush x:Key="TileIconBorderBrush" Color="#4010B981" />
        <SolidColorBrush x:Key="TileIconGlyphBrush" Color="#34D399" />

        <!-- Readable Mint Green Action Links (#34D399 -> Hover #6EE7B7) -->
        <SolidColorBrush x:Key="TileActionLinkBrush" Color="#34D399" />
        <SolidColorBrush x:Key="TileActionLinkHoverBrush" Color="#6EE7B7" />

        <!-- Sleek Dark-Mode Pill Badges: rgba(255, 255, 255, 0.08) background with #E2E8F0 or #34D399 text -->
        <SolidColorBrush x:Key="DarkPillBackgroundBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="DarkPillBorderBrush" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="DarkPillTextBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="DarkPillAccentTextBrush" Color="#34D399" />

        <!-- Deep Slate Card Elevation Drop Shadow -->
        <DropShadowEffect x:Key="FluentGlassShadow"
                          BlurRadius="20"
                          ShadowDepth="4"
                          Direction="270"
                          Color="#020617"
                          Opacity="0.45" />

        <!-- Smooth Hover Elevation Shadow for 8-Card Grid -->
        <DropShadowEffect x:Key="FluentGlassHoverShadow"
                          BlurRadius="26"
                          ShadowDepth="6"
                          Direction="270"
                          Color="#052E16"
                          Opacity="0.55" />

        <!-- Readable Bottom Card Action Link Style (#34D399 with smooth hover brightness) -->
        <Style x:Key="TileActionLinkTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TileActionLinkBrush}" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TileActionLinkHoverBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Clickable 4x2 Glass Dashboard Tile Button Style with Smooth Hover Elevation -->
        <Style x:Key="FluentGlassTileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,15" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Display, Segoe UI" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource FluentGlassShadow}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource GlassElevatedBrush}" />
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#10B981" />
                                <Setter TargetName="TileBorder" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="TileBorder" Property="Effect" Value="{StaticResource FluentGlassHoverShadow}" />
                                <Setter TargetName="TileBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-2" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Opacity" Value="0.92" />
                                <Setter TargetName="TileBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="0" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Fluent Action Button Style -->
        <Style x:Key="ModernActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DarkPillBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DarkPillTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1F10B981" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#10B981" />
                                <Setter Property="Foreground" Value="#34D399" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Emerald (#10B981 -> Hover #059669) CTA Button Style -->
        <Style x:Key="PrimaryFluentCtaButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernActionButtonStyle}">
            <Setter Property="Background" Value="#059669" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#10B981" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBtnBorder" Property="Background" Value="#10B981" />
                                <Setter TargetName="PrimaryBtnBorder" Property="BorderBrush" Value="#34D399" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryBtnBorder" Property="Background" Value="#047857" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Chrome Caption Button Style (Minimize —, Maximize/Restore □) -->
        <Style x:Key="CaptionControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CapBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CapBorder" Property="Background" Value="#14FFFFFF" />
                                <Setter Property="Foreground" Value="#34D399" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Chrome Close Button Style -->
        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder" Background="{TemplateBinding Background}" CornerRadius="0,10,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#F42A41" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Deep-Slate ListBoxItem Style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#14FFFFFF" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1F10B981" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#10B981" />
                                <Setter Property="Foreground" Value="#34D399" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
