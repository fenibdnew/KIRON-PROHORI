<Application x:Class="KironProhori.Agent.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#080D1A" />
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="#0E1628" />
        <SolidColorBrush x:Key="BorderHairlineBrush" Color="#1E2D4A" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#2563EB" />
    </Application.Resources>
</Application>
