<Window x:Class="KironProhori.Agent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KIRON PROHORI — Windows Security"
        Icon="pack://application:,,,/Assets/KironProhori.ico"
        Height="780"
        Width="1240"
        MinHeight="640"
        MinWidth="980"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppCanvasBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="10"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="OuterWindowFrame"
            Background="{DynamicResource AppCanvasBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Draggable Top Fluent Title Bar -->
                <RowDefinition Height="42" />
                <!-- Row 1: Main Application Canvas -->
                <RowDefinition Height="*" />
                <!-- Row 2: Clean Bottom Utility Bar (Settings Gear, Notifications Bell, About/License, Status) -->
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- ROW 0: DRAGGABLE FLUENT TITLE BAR & WINDOW CONTROLS (—, □, ✕)             -->
            <!-- ========================================================================= -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Official Transparent 'KP' Eco-Digital Shield Emblem (High-DPI Anti-Aliased PNG, Vector Geometry: M 23,31 L 23,69 M 23,51 L 45,31 M 30,45 L 46,69 M 56,31 L 56,69) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="pack://application:,,,/Assets/kp-logo.png"
                               Width="22"
                               Height="22"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True" />
                        <TextBlock x:Name="AppTitleBlock"
                                   Text="KIRON PROHORI"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="—"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="6,0,6,0"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="AppSubtitleBlock"
                                   Text="Windows Security &amp; Antivirus V1.0"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <!-- Subtle Low-Opacity Titlebar Status Indicators (No Glaring Solid Pills) -->
                        <Border x:Name="EcoPowerModeHeaderBadge"
                                Background="#1410B981"
                                BorderBrush="#2610B981"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8,2"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="EcoPowerModeHeaderText"
                                       Text="● Eco-Mode Active · Low Energy"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="#34D399" />
                        </Border>
                        <Border Background="#10FFFFFF"
                                BorderBrush="#1E293B"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8,2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="● AI-ERA RADAR · $0 FREE"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="#94A3B8" />
                        </Border>
                    </StackPanel>

                    <!-- Right: Eco-Power Toggle + Language/Theme Pills + Minimize (—), Maximize/Restore (□), Close (✕) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="EcoModeQuickToggleBtn"
                                Content="Eco: ON"
                                ToolTip="Toggle Eco-Power Mode (Green Computing: auto-throttles when CPU &gt; 40% or on battery)"
                                Click="OnToggleEcoPowerModeClick"
                                Style="{StaticResource CaptionControlButtonStyle}"
                                Width="72"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#34D399" />
                        <Button x:Name="LanguageToggleButton"
                                Content="EN / বাংলা"
                                ToolTip="Switch Interface Language (English / বাংলা)"
                                Click="OnToggleLanguageClick"
                                Style="{StaticResource CaptionControlButtonStyle}"
                                Width="74"
                                FontSize="11.5"
                                FontWeight="SemiBold" />
                        <Button x:Name="ThemeToggleButton"
                                Content="☀ / ☾"
                                ToolTip="Toggle Light Minimal Glass / Obsidian Dark Theme"
                                Click="OnToggleThemeClick"
                                Style="{StaticResource CaptionControlButtonStyle}"
                                Width="52"
                                FontSize="12" />
                        <Button x:Name="MinimizeWindowBtn"
                                Content="—"
                                ToolTip="Minimize Window"
                                Click="OnMinimizeWindowClick"
                                Style="{StaticResource CaptionControlButtonStyle}" />
                        <Button x:Name="MaximizeRestoreWindowBtn"
                                Content="□"
                                ToolTip="Maximize / Restore Window"
                                Click="OnMaximizeRestoreWindowClick"
                                Style="{StaticResource CaptionControlButtonStyle}" />
                        <Button x:Name="CloseWindowBtn"
                                Content="✕"
                                ToolTip="Close to System Tray (or Exit)"
                                Click="OnCloseWindowClick"
                                Style="{StaticResource CaptionCloseButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 1: MAIN WORKSPACE CANVAS                                              -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="1" Margin="24,18,24,14">

                <!-- ===================================================================== -->
                <!-- VIEW 1: KASPERSKY-INSPIRED MINIMAL GLASS DASHBOARD (HERO + 4x2 TILES) -->
                <!-- ===================================================================== -->
                <Grid x:Name="DashboardHeroViewPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <!-- Top Hero Protection Banner -->
                        <RowDefinition Height="Auto" />
                        <!-- Main 4x2 Clickable Glass Tile Grid -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- TOP HERO PROTECTION BANNER -->
                    <Border x:Name="HeroProtectionBannerBorder"
                            Grid.Row="0"
                            CornerRadius="16"
                            BorderBrush="#1E293B"
                            BorderThickness="1.5"
                            Padding="26,22"
                            Margin="6,0,6,14"
                            Effect="{StaticResource FluentGlassShadow}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="HeroGradStop1" Color="#0D192B" Offset="0.0" />
                                <GradientStop x:Name="HeroGradStop2" Color="#111827" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Official Transparent 'KP' Eco-Digital Shield Emblem with Soft Glass Frame & Ambient Emerald Glow -->
                            <Border x:Name="HeroShieldIconBadge"
                                    Grid.Column="0"
                                    Width="72"
                                    Height="72"
                                    CornerRadius="18"
                                    Background="#E6F4EF"
                                    BorderBrush="#4010B981"
                                    BorderThickness="1"
                                    Margin="0,0,22,0"
                                    VerticalAlignment="Center"
                                    Effect="{StaticResource FluentGlassShadow}">
                                <Grid>
                                    <Image Source="pack://application:,,,/Assets/kp-logo.png"
                                           Width="56"
                                           Height="56"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True"
                                           UseLayoutRounding="True" />
                                    <!-- Hidden compatibility element for code-behind state updates -->
                                    <Border x:Name="HeroShieldCornerCheck" Visibility="Collapsed">
                                        <TextBlock x:Name="HeroShieldGlyphText" Text="KP" Visibility="Collapsed" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Headline, Sleek Dark-Mode Coexistence Badges & Subtext -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="HeroStatusPillBorder"
                                            Background="#1F10B981"
                                            BorderBrush="#4010B981"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,3"
                                            Margin="0,0,8,4">
                                        <TextBlock x:Name="HeroStatusPillText"
                                                   Text="PROTECTION LIVE · ECO-AI"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#34D399" />
                                    </Border>
                                    <Border Background="{DynamicResource DarkPillBackgroundBrush}"
                                            BorderBrush="{DynamicResource DarkPillBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="9,3"
                                            Margin="0,0,8,4">
                                        <TextBlock x:Name="DefenderStatusText"
                                                   Text="Defender: Coexisting"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DarkPillTextBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource DarkPillBackgroundBrush}"
                                            BorderBrush="{DynamicResource DarkPillBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="9,3"
                                            Margin="0,0,8,4">
                                        <TextBlock x:Name="FirewallStatusText"
                                                   Text="Firewall: Active"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DarkPillAccentTextBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource DarkPillBackgroundBrush}"
                                            BorderBrush="{DynamicResource DarkPillBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="9,3"
                                            Margin="0,0,0,4">
                                        <TextBlock x:Name="SignatureVersionText"
                                                   Text="Signature: Ready"
                                                   FontSize="10.5"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource DarkPillTextBrush}" />
                                    </Border>
                                </WrapPanel>

                                <TextBlock x:Name="HeroHeadlineText"
                                           Text="Your protection is live now"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,5,0,3" />

                                <TextBlock x:Name="HeroSubheadlineText"
                                           Text="Eco-Power Green Computing Mode, Local Heuristic AI Risk Score (0–100), Infostealer &amp; Fake AI App Guard, and Chrome/Edge MV3 Web Protection are active."
                                           FontSize="12.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Primary Quick Scan, USB Scan & USB Folder Recovery Buttons (No Glaring White Backgrounds) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="HeroQuickScanCtaBtn"
                                        Content="⚡ Quick Scan"
                                        Click="OnQuickScanClick"
                                        Style="{StaticResource PrimaryFluentCtaButtonStyle}"
                                        Margin="0,0,8,0" />
                                <Button x:Name="HeroUsbScanBtn"
                                        Content="🔌 USB Scan"
                                        Click="OnUsbScanClick"
                                        Style="{StaticResource ModernActionButtonStyle}"
                                        Background="#1F10B981"
                                        Foreground="#34D399"
                                        BorderBrush="#4010B981"
                                        Padding="14,10"
                                        Margin="0,0,8,0" />
                                <Button x:Name="HeroDetailsBtn"
                                        Content="📂 Recover USB"
                                        ToolTip="Unhide folders hidden by USB shortcut viruses"
                                        Click="OnRecoverUsbHiddenFoldersClick"
                                        Style="{StaticResource ModernActionButtonStyle}"
                                        Background="{DynamicResource DarkPillBackgroundBrush}"
                                        Foreground="{DynamicResource DarkPillTextBrush}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                        Padding="14,10" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- MAIN 4x2 ACTION TILE GRID (8 CARDS WITH TRANSLUCENT EMERALD CONTAINERS, LUCIDE ICONS & DARK PILLS) -->
                    <UniformGrid Grid.Row="1" Columns="4" Rows="2">

                        <!-- Tile 1: Malware Scan -->
                        <Button x:Name="NavQuickScanBtn"
                                Click="OnOpenScanCenterTileClick"
                                Style="{StaticResource FluentGlassTileButtonStyle}">
                            <DockPanel LastChildFill="True">
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource TileIconBoxBrush}" BorderBrush="{DynamicResource TileIconBorderBrush}" BorderThickness="1">
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <!-- Lucide Search / Scan Radar Outline Icon (#34D399) -->
                                                <Path Data="M 11,4 A 7,7 0 1 1 10.99,4 Z M 16.2,16.2 L 21,21 M 8,11 L 14,11 M 11,8 L 11,14"
                                                      Stroke="{DynamicResource TileIconGlyphBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource DarkPillBackgroundBrush}" BorderBrush="{DynamicResource DarkPillBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2.5">
                                        <TextBlock x:Name="TileScanBadgeText" Text="4 MODES" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource DarkPillTextBrush}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="Open Scanner →" Style="{StaticResource TileActionLinkTextStyle}" />
                                <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock x:Name="Tile1TitleText" Text="Malware Scan" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Quick · Full · Folder · USB"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <!-- Tile 2: Web & Download Guard -->
                        <Button x:Name="NavWebProtectionBtn"
                                Click="OnWebProtectionViewClick"
                                Style="{StaticResource FluentGlassTileButtonStyle}">
                            <DockPanel LastChildFill="True">
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource TileIconBoxBrush}" BorderBrush="{DynamicResource TileIconBorderBrush}" BorderThickness="1">
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <!-- Lucide Globe Outline Icon (#34D399) -->
                                                <Path Data="M 12,2 A 10,10 0 1 1 11.99,2 Z M 2.5,9 L 21.5,9 M 2.5,15 L 21.5,15 M 12,2 C 9,6.5 9,17.5 12,22 C 15,17.5 15,6.5 12,2 Z"
                                                      Stroke="{DynamicResource TileIconGlyphBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource DarkPillBackgroundBrush}" BorderBrush="{DynamicResource DarkPillBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2.5">
                                        <TextBlock Text="MV3 READY" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource DarkPillAccentTextBrush}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="Browser Shield →" Style="{StaticResource TileActionLinkTextStyle}" />
                                <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock x:Name="Tile2TitleText" Text="Web &amp; Download" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Phishing &amp; File Guard"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <!-- Tile 3: Real-Time Guard -->
                        <Button x:Name="NavRealtimeBtn"
                                Click="OnRealtimeGuardToggleClick"
                                Style="{StaticResource FluentGlassTileButtonStyle}">
                            <DockPanel LastChildFill="True">
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource TileIconBoxBrush}" BorderBrush="{DynamicResource TileIconBorderBrush}" BorderThickness="1">
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <!-- Lucide Shield-Activity Outline Icon (#34D399) -->
                                                <Path Data="M 12,2.5 L 4.5,5.8 L 4.5,11.5 C 4.5,16.6 7.7,21 12,22.5 C 16.3,21 19.5,16.6 19.5,11.5 L 19.5,5.8 Z M 7.5,12.5 L 10,12.5 L 11.4,9.2 L 12.8,15.2 L 14.2,12.5 L 16.5,12.5"
                                                      Stroke="{DynamicResource TileIconGlyphBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource DarkPillBackgroundBrush}" BorderBrush="{DynamicResource DarkPillBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2.5">
                                        <TextBlock x:Name="DashCardRealtimeBadge" Text="READY" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource DarkPillAccentTextBrush}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="Live Shield →" Style="{StaticResource TileActionLinkTextStyle}" />
                                <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock x:Name="Tile3TitleText" Text="Real-Time Guard" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Live Folder &amp; USB Monitor"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <!-- Tile 4: Quarantine Vault -->
                        <Button x:Name="NavQuarantineBtn"
                                Click="OnRefreshQuarantineClick"
                                Style="{StaticResource FluentGlassTileButtonStyle}">
                            <DockPanel LastChildFill="True">
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource TileIconBoxBrush}" BorderBrush="{DynamicResource TileIconBorderBrush}" BorderThickness="1">
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <!-- Lucide Lock Vault Outline Icon (#34D399) -->
                                                <Path Data="M 7,11 L 17,11 C 18.1,11 19,11.9 19,13 L 19,20 C 19,21.1 18.1,22 17,22 L 7,22 C 5.9,22 5,21.1 5,20 L 5,13 C 5,11.9 5.9,11 7,11 Z M 8,11 L 8,7.5 C 8,5.3 9.8,3.5 12,3.5 C 14.2,3.5 16,5.3 16,7.5 L 16,11 M 12,15 L 12,18"
                                                      Stroke="{DynamicResource TileIconGlyphBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource DarkPillBackgroundBrush}" BorderBrush="{DynamicResource DarkPillBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2.5">
                                        <TextBlock x:Name="DashCardQuarantineBadge" Text="0 ISOLATED" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource DarkPillTextBrush}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="Open Vault →" Style="{StaticResource TileActionLinkTextStyle}" />
                                <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock x:Name="Tile4TitleText" Text="Quarantine Vault" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Restore or Delete Threats"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <!-- Tile 5: Scan History -->
                        <Button x:Name="NavHistoryBtn"
                                Click="OnThreatHistoryClick"
                                Style="{StaticResource FluentGlassTileButtonStyle}">
                            <DockPanel LastChildFill="True">
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource TileIconBoxBrush}" BorderBrush="{DynamicResource TileIconBorderBrush}" BorderThickness="1">
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <!-- Lucide File-Text / History Log Outline Icon (#34D399) -->
                                                <Path Data="M 6,3 L 14.5,3 L 19,7.5 L 19,21 L 6,21 Z M 14.5,3 L 14.5,7.5 L 19,7.5 M 9,12 L 16,12 M 9,16 L 14,16"
                                                      Stroke="{DynamicResource TileIconGlyphBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource DarkPillBackgroundBrush}" BorderBrush="{DynamicResource DarkPillBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2.5">
                                        <TextBlock x:Name="DiagnosticsHealthText" Text="HEALTHY" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource DarkPillAccentTextBrush}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="View Logs →" Style="{StaticResource TileActionLinkTextStyle}" />
                                <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock x:Name="Tile5TitleText" Text="Scan History" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Past Scans &amp; Activity"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <!-- Tile 6: Threat Engines -->
                        <Button x:Name="NavSecurityIntelBtn"
                                Click="OnSecurityIntelligenceViewClick"
                                Style="{StaticResource FluentGlassTileButtonStyle}">
                            <DockPanel LastChildFill="True">
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource TileIconBoxBrush}" BorderBrush="{DynamicResource TileIconBorderBrush}" BorderThickness="1">
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <!-- Lucide Cpu / AI Engine Outline Icon (#34D399) -->
                                                <Path Data="M 7,7 L 17,7 L 17,17 L 7,17 Z M 10,10 L 14,10 L 14,14 L 10,14 Z M 9,3 L 9,7 M 15,3 L 15,7 M 9,17 L 9,21 M 15,17 L 15,21 M 3,9 L 7,9 M 3,15 L 7,15 M 17,9 L 21,9 M 17,15 L 21,15"
                                                      Stroke="{DynamicResource TileIconGlyphBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource DarkPillBackgroundBrush}" BorderBrush="{DynamicResource DarkPillBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2.5">
                                        <TextBlock Text="AI · SHA256" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource DarkPillTextBrush}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="Engine Status →" Style="{StaticResource TileActionLinkTextStyle}" />
                                <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock x:Name="Tile6TitleText" Text="Threat Engines" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="AI Risk · Heuristics · YARA"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <!-- Tile 7: Check Updates -->
                        <Button x:Name="NavUpdatesBtn"
                                Click="OnCheckUpdatesClick"
                                Style="{StaticResource FluentGlassTileButtonStyle}">
                            <DockPanel LastChildFill="True">
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource TileIconBoxBrush}" BorderBrush="{DynamicResource TileIconBorderBrush}" BorderThickness="1">
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <!-- Lucide Refresh-Cw Outline Icon (#34D399) -->
                                                <Path Data="M 20,11 A 8,8 0 0 0 5.3,6.6 L 3,9 M 3,4 L 3,9 L 8,9 M 4,13 A 8,8 0 0 0 18.7,17.4 L 21,15 M 21,20 L 21,15 L 16,15"
                                                      Stroke="{DynamicResource TileIconGlyphBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource DarkPillBackgroundBrush}" BorderBrush="{DynamicResource DarkPillBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2.5">
                                        <TextBlock Text="SIGNED HTTPS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource DarkPillAccentTextBrush}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="Check Now →" Style="{StaticResource TileActionLinkTextStyle}" />
                                <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock x:Name="Tile7TitleText" Text="Check Updates" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Signed Database &amp; App"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <!-- Tile 8: Security Tools & Rootkit Scan -->
                        <Button x:Name="NavExclusionsBtn"
                                Click="OnExclusionsViewClick"
                                Style="{StaticResource FluentGlassTileButtonStyle}">
                            <DockPanel LastChildFill="True">
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource TileIconBoxBrush}" BorderBrush="{DynamicResource TileIconBorderBrush}" BorderThickness="1">
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <!-- Lucide Wrench / Security Tools Outline Icon (#34D399) -->
                                                <Path Data="M 14.7,6.3 A 4,4 0 0 0 9.4,11.6 L 4,17 L 7,20 L 12.4,14.6 A 4,4 0 0 0 17.7,9.3 L 15.2,11.8 L 12.2,8.8 Z"
                                                      Stroke="{DynamicResource TileIconGlyphBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource DarkPillBackgroundBrush}" BorderBrush="{DynamicResource DarkPillBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2.5">
                                        <TextBlock x:Name="QuarantineCountText" Text="0 EXCLUDED" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource DarkPillTextBrush}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="Open Tools →" Style="{StaticResource TileActionLinkTextStyle}" />
                                <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock x:Name="Tile8TitleText" Text="Security Tools" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Exclusions · USB · Rootkit"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                    </UniformGrid>
                </Grid>

                <!-- ===================================================================== -->
                <!-- VIEW 2: DEDICATED SUB-PAGE WORKSPACE (WITH BACK TO DASHBOARD ←)       -->
                <!-- ===================================================================== -->
                <Grid x:Name="ScannerAndInspectorViewPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Sub-Page Top Header with Back Button & Contextual Module Selectors -->
                        <RowDefinition Height="Auto" />
                        <!-- Live Scan Progress & Contextual Action Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Split Detection Findings & Contextual Inspector -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Sub-Page Header Bar with Back to Dashboard (←) -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource GlassCardBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16,12"
                            Margin="0,0,0,12"
                            Effect="{StaticResource FluentGlassShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Back to Dashboard Button -->
                            <Button x:Name="NavOverviewBtn"
                                    Grid.Column="0"
                                    Content="← Back to Dashboard"
                                    Click="OnNavigateOverviewClick"
                                    Style="{StaticResource ModernActionButtonStyle}"
                                    Margin="0,0,14,0" />

                            <!-- Sub-Page Section Title & Disclosure -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock x:Name="CurrentSectionTitle"
                                           Text="Scan Center"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DisclosureBannerText"
                                           Text="User-Mode Windows Companion · Coexists with Microsoft Defender · No Automatic File Upload · No Telemetry by Default"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Global Scan Control Buttons (Strictly Visible ONLY on Scan Pages) -->
                            <WrapPanel x:Name="GlobalScanControlsToolbar"
                                       Grid.Column="2"
                                       Orientation="Horizontal"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed">
                                <Button x:Name="PauseResumeScanBtn"
                                        Content="Pause Scan"
                                        Click="OnPauseResumeScanClick"
                                        Style="{StaticResource ModernActionButtonStyle}"
                                        Margin="0,0,6,0" />
                                <Button x:Name="CancelScanBtn"
                                        Content="Stop Scan"
                                        Click="OnCancelScanClick"
                                        Style="{StaticResource ModernActionButtonStyle}"
                                        Foreground="#DC2626"
                                        BorderBrush="#FCA5A5"
                                        Margin="0,0,6,0" />
                                <Button x:Name="RunEicarSelfTestBtn"
                                        Content="Run Safe EICAR Self-Test"
                                        Click="OnRunEicarSelfTestClick"
                                        Style="{StaticResource ModernActionButtonStyle}"
                                        Background="#0284C7"
                                        Foreground="#FFFFFF"
                                        BorderBrush="#0284C7" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Contextual Feature Header & Action Bar -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource GlassCardBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16,12"
                            Margin="0,0,0,12"
                            Effect="{StaticResource FluentGlassShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <!-- Proper Grid Columns (* and Auto) with TextTrimming so title/state never overlaps metrics -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock x:Name="ActiveScanBannerTitle"
                                                   Text="MODULAR MULTI-ENGINE SCANNER PIPELINE"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#0284C7"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="ScanStateText"
                                                   Text=" · IDLE"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#059669"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock x:Name="ScanMetricsText"
                                               Grid.Column="1"
                                               Text="0 scanned · 0 detections · 0 skipped"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <ProgressBar x:Name="ScanProgressBar"
                                             Height="7"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             Background="#E2E8F0"
                                             Foreground="#0284C7"
                                             BorderThickness="0"
                                             Margin="0,7,0,4" />
                                <TextBlock x:Name="ActiveScanLivePathText"
                                           Text="Ready"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Contextual Feature Action Buttons (Only the toolbar matching the active view is shown) -->
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Scan Mode Selector Bar (ONLY on Scan View) -->
                                <StackPanel x:Name="ScanModesSubToolbar" Orientation="Horizontal" Visibility="Collapsed">
                                    <Button Content="⚡ Quick Scan" Click="OnQuickScanClick" Style="{StaticResource PrimaryFluentCtaButtonStyle}" Padding="12,6" FontSize="11.5" Margin="0,0,6,0" />
                                    <Button x:Name="NavFullScanBtn" Content="🖥 Full Scan" Click="OnFullScanClick" Style="{StaticResource ModernActionButtonStyle}" Padding="12,6" FontSize="11.5" Margin="0,0,6,0" />
                                    <Button x:Name="NavCustomScanBtn" Content="📁 Custom Folder" Click="OnCustomScanClick" Style="{StaticResource ModernActionButtonStyle}" Padding="12,6" FontSize="11.5" Margin="0,0,6,0" />
                                    <Button x:Name="NavUsbScanBtn" Content="🔌 USB Scan" Click="OnUsbScanClick" Style="{StaticResource ModernActionButtonStyle}" Padding="12,6" FontSize="11.5" Margin="0,0,6,0" />
                                    <Button x:Name="RecoverUsbFoldersBtn" Content="📂 Recover USB Folders" Click="OnRecoverUsbHiddenFoldersClick" Style="{StaticResource ModernActionButtonStyle}" Padding="12,6" FontSize="11.5" Margin="0,0,6,0" />
                                    <Button x:Name="NavEmailAttachmentScanBtn" Content="📧 Email Attachment" ToolTip="Scan downloaded email attachments locally (Direct mailbox access: Planned)" Click="OnEmailAttachmentScanClick" Style="{StaticResource ModernActionButtonStyle}" Padding="12,6" FontSize="11.5" />
                                </StackPanel>

                                <!-- Web & Download Sub-Tab Switcher -->
                                <StackPanel x:Name="WebAndDownloadSubToolbar" Orientation="Horizontal" Visibility="Collapsed">
                                    <Button Content="🌐 Web Guard (ON)" Click="OnWebProtectionViewClick" Style="{StaticResource PrimaryFluentCtaButtonStyle}" Padding="12,6" FontSize="11.5" Margin="0,0,6,0" />
                                    <Button x:Name="NavDownloadProtectionBtn" Content="⬇ Download Guard" Click="OnDownloadProtectionViewClick" Style="{StaticResource ModernActionButtonStyle}" Padding="12,6" FontSize="11.5" Margin="0,0,6,0" />
                                    <Button x:Name="NavSafeBankingBtn" Content="🏦 Safe Banking (HTTPS)" ToolTip="Verify HTTPS financial domains &amp; phishing redirects (Hardened Browser: Planned)" Click="OnSafeBankingViewClick" Style="{StaticResource ModernActionButtonStyle}" Padding="12,6" FontSize="11.5" />
                                </StackPanel>

                                <!-- Exclusions, Defender, Firewall, Ransomware Shield, Privacy & Deep Rootkit Offline Scan Sub-Tab Switcher -->
                                <StackPanel x:Name="ExclusionsAndFirewallSubToolbar" Orientation="Horizontal" Visibility="Collapsed">
                                    <Button x:Name="AddCustomExclusionBtn" Content="➕ Add Exclusion" ToolTip="Add a trusted folder or file to KIRON PROHORI Exclusions" Click="OnAddCustomExclusionClick" Style="{StaticResource PrimaryFluentCtaButtonStyle}" Padding="12,6" FontSize="11.5" Margin="0,0,6,0" />
                                    <Button Content="⚙ Exclusions" Click="OnExclusionsViewClick" Style="{StaticResource ModernActionButtonStyle}" Padding="12,6" FontSize="11.5" Margin="0,0,6,0" />
                                    <Button x:Name="NavDefenderBtn" Content="🛡 Defender Status" Click="OnRefreshWindowsSecurityClick" Style="{StaticResource ModernActionButtonStyle}" Padding="12,6" FontSize="11.5" Margin="0,0,6,0" />
                                    <Button x:Name="NavFirewallBtn" Content="🔥 Firewall" Click="OnFirewallViewClick" Style="{StaticResource ModernActionButtonStyle}" Padding="12,6" FontSize="11.5" Margin="0,0,6,0" />
                                    <Button x:Name="NavRansomwareShieldBtn" Content="🔒 Ransomware Shield" Click="OnRansomwareShieldViewClick" Style="{StaticResource ModernActionButtonStyle}" Padding="12,6" FontSize="11.5" Margin="0,0,6,0" />
                                    <Button x:Name="RunHarmlessRansomSimBtn" Content="🧪 Ransom Sim" ToolTip="Run harmless sandbox ransomware simulation without touching user files" Click="OnRunHarmlessRansomwareSimulationClick" Style="{StaticResource ModernActionButtonStyle}" Padding="12,6" FontSize="11.5" Margin="0,0,6,0" />
                                    <Button x:Name="NavPrivacyProtectionBtn" Content="📷 Privacy (Cam/Mic)" Click="OnPrivacyProtectionViewClick" Style="{StaticResource ModernActionButtonStyle}" Padding="12,6" FontSize="11.5" Margin="0,0,6,0" />
                                    <Button x:Name="LaunchDefenderOfflineRootkitBtn" Content="🧰 Defender Offline Scan" ToolTip="Launch Windows Defender Offline Scan for deep kernel/rootkit removal" Click="OnLaunchDefenderOfflineScanClick" Style="{StaticResource ModernActionButtonStyle}" Padding="12,6" FontSize="11.5" />
                                </StackPanel>

                                <!-- Dedicated Updates Action Bar -->
                                <StackPanel x:Name="UpdatesSubToolbar" Orientation="Horizontal" Visibility="Collapsed">
                                    <Button x:Name="CheckForUpdatesNowBtn" Content="🔄 Check for Updates Now" Click="OnCheckUpdatesClick" Style="{StaticResource PrimaryFluentCtaButtonStyle}" Padding="16,8" FontSize="12" />
                                </StackPanel>

                                <!-- Dedicated Notifications Action Bar -->
                                <StackPanel x:Name="NotificationsSubToolbar" Orientation="Horizontal" Visibility="Collapsed">
                                    <Button Content="🔊 Test Gentle 280ms Chime" Click="OnPlayGentleChimeClick" Style="{StaticResource PrimaryFluentCtaButtonStyle}" Padding="14,7" FontSize="11.5" />
                                </StackPanel>

                                <!-- Real-Time Guard Live Toggle -->
                                <Button x:Name="ToggleRealtimeMonitoringBtn"
                                        Content="Enable Real-Time Guard"
                                        Click="OnToggleRealtimeEngineClick"
                                        Style="{StaticResource PrimaryFluentCtaButtonStyle}"
                                        Padding="14,7"
                                        FontSize="12"
                                        Visibility="Collapsed" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Split Detections Table (Scan Pages Only) & Full-Width Dedicated Feature Card (Non-Scan Pages) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="LeftDetectionsGridColumn" Width="1.25*" />
                            <ColumnDefinition x:Name="RightInspectorGridColumn" Width="1.15*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Card: Detection Findings (Strictly Visible ONLY on Scan Pages) -->
                        <Border x:Name="LeftScanDetectionsCardBorder"
                                Grid.Column="0"
                                Background="{DynamicResource GlassCardBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,8,0"
                                Effect="{StaticResource FluentGlassShadow}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="SCAN DETECTIONS (QUARANTINE-FIRST POLICY)"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Button Content="Quarantine (Recommended)"
                                                Click="OnQuarantineSelectedFindingClick"
                                                Style="{StaticResource ModernActionButtonStyle}"
                                                Background="#D97706"
                                                Foreground="#FFFFFF"
                                                BorderBrush="#B45309"
                                                Padding="10,5"
                                                Margin="0,0,6,0" />
                                        <Button Content="Ignore Once"
                                                Click="OnIgnoreSelectedFindingOnceClick"
                                                Style="{StaticResource ModernActionButtonStyle}"
                                                Padding="10,5"
                                                Margin="0,0,6,0" />
                                        <Button Content="Add Exclusion"
                                                Click="OnExcludeSelectedFindingClick"
                                                Style="{StaticResource ModernActionButtonStyle}"
                                                Foreground="#0284C7"
                                                BorderBrush="#7DD3FC"
                                                Padding="10,5" />
                                    </WrapPanel>
                                </DockPanel>

                                <ListBox x:Name="FindingsListBox"
                                         Background="{DynamicResource GlassElevatedBrush}"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         BorderBrush="{DynamicResource GlassBorderBrush}"
                                         BorderThickness="1"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Right Card: Dedicated Full-Width Feature Inspector (or Right Column on Scan Pages) -->
                        <Border x:Name="RightInspectorCardBorder"
                                Grid.Column="1"
                                Background="{DynamicResource GlassCardBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="8,0,0,0"
                                Effect="{StaticResource FluentGlassShadow}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock x:Name="RightPanelHeaderText"
                                               Text="MODULE DETAILS &amp; RECORDS"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- STRICT RULE: Restore & Permanent Delete ONLY appear inside Quarantine Vault -->
                                    <StackPanel x:Name="QuarantineActionButtonsPanel"
                                                DockPanel.Dock="Right"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Visibility="Collapsed">
                                        <Button Content="Restore Selected"
                                                Click="OnRestoreSelectedQuarantineClick"
                                                Style="{StaticResource ModernActionButtonStyle}"
                                                Background="#059669"
                                                Foreground="#FFFFFF"
                                                BorderBrush="#047857"
                                                Padding="10,5"
                                                Margin="0,0,6,0" />
                                        <Button Content="Permanent Delete"
                                                Click="OnDeleteSelectedQuarantineClick"
                                                Style="{StaticResource ModernActionButtonStyle}"
                                                Background="#DC2626"
                                                Foreground="#FFFFFF"
                                                BorderBrush="#B91C1C"
                                                Padding="10,5" />
                                    </StackPanel>
                                </DockPanel>

                                <ListBox x:Name="QuarantineListBox"
                                         Background="{DynamicResource GlassElevatedBrush}"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         BorderBrush="{DynamicResource GlassBorderBrush}"
                                         BorderThickness="1"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===================================================================== -->
                <!-- VIEW 3: SETTINGS SUB-PAGE (THEME, LANGUAGE, TRAY BEHAVIOR, THROTTLE)  -->
                <!-- ===================================================================== -->
                <ScrollViewer x:Name="SettingsDedicatedViewPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{DynamicResource GlassCardBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="22,18"
                                Effect="{StaticResource FluentGlassShadow}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <Button Content="← Back to Dashboard"
                                            Click="OnNavigateOverviewClick"
                                            Style="{StaticResource ModernActionButtonStyle}"
                                            Margin="0,0,14,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="KIRON PROHORI Settings &amp; Preferences"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="Stored locally in %LOCALAPPDATA%\KironProhori with automatic .known_good self-repair backup."
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </DockPanel>

                                <UniformGrid Columns="2" Rows="2">
                                    <!-- Card 1: Visual Theme (Light Minimal Glass / Obsidian Dark) -->
                                    <Border Background="{DynamicResource GlassElevatedBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="APPEARANCE &amp; GLASS THEME" FontSize="10.5" FontWeight="Bold" Foreground="#0284C7" />
                                            <TextBlock x:Name="SettingsThemeStatusText" Text="Light Minimal Glass (Default)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,4" />
                                            <TextBlock Text="Switch between Windows 11 Light Minimal Glass (#F4F7FB) and Obsidian Dark (#0B1120)." FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                            <Button Content="Toggle Light Minimal Glass / Obsidian Dark"
                                                    Click="OnToggleThemeClick"
                                                    Style="{StaticResource ModernActionButtonStyle}"
                                                    HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 2: Interface Language (EN / বাংলা) -->
                                    <Border Background="{DynamicResource GlassElevatedBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="8,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="BILINGUAL INTERFACE LANGUAGE" FontSize="10.5" FontWeight="Bold" Foreground="#059669" />
                                            <TextBlock x:Name="SettingsLanguageStatusText" Text="English (EN)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,4" />
                                            <TextBlock Text="Instantaneously translate dashboard headers, tiles, and guidance between English and Bengali (বাংলা)." FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                            <Button Content="Switch Language (EN / বাংলা)"
                                                    Click="OnToggleLanguageClick"
                                                    Style="{StaticResource ModernActionButtonStyle}"
                                                    HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 3: Close Button & System Tray Behavior -->
                                    <Border Background="{DynamicResource GlassElevatedBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,8,8,0">
                                        <StackPanel>
                                            <TextBlock Text="WINDOW CLOSE (✕) &amp; SYSTEM TRAY BEHAVIOR" FontSize="10.5" FontWeight="Bold" Foreground="#0284C7" />
                                            <TextBlock x:Name="SettingsCloseBehaviorText" Text="Minimize to System Tray on Close (Recommended)" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,4" />
                                            <TextBlock Text="Choose whether clicking ✕ keeps KIRON PROHORI protecting quietly in the Windows System Tray or exits the application." FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                            <Button x:Name="ToggleCloseBehaviorBtn"
                                                    Content="Toggle: Minimize to Tray / Exit on Close"
                                                    Click="OnToggleCloseToTrayBehaviorClick"
                                                    Style="{StaticResource ModernActionButtonStyle}"
                                                    HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 4: Eco-Power Mode (Green Computing) & Gentle 280ms Chime -->
                                    <Border Background="{DynamicResource GlassElevatedBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="8,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ECO-POWER MODE (GREEN COMPUTING) &amp; AUDIO" FontSize="10.5" FontWeight="Bold" Foreground="#006A4E" />
                                            <TextBlock x:Name="SettingsPerformanceProfileText" Text="Eco-Mode Active · Low Energy (CPU Cap 35%)" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,4" />
                                            <TextBlock Text="Automatically throttles background scanning when CPU usage &gt; 40% or on laptop battery power, and uses 64 KB streaming." FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                            <WrapPanel Orientation="Horizontal">
                                                <Button x:Name="ToggleEcoPowerSettingsBtn"
                                                        Content="Toggle Eco-Power Mode"
                                                        Click="OnToggleEcoPowerModeClick"
                                                        Style="{StaticResource PrimaryFluentCtaButtonStyle}"
                                                        Padding="12,6"
                                                        FontSize="11.5"
                                                        Margin="0,0,8,4" />
                                                <Button x:Name="TestGentleChimeBtn"
                                                        Content="Play Gentle Chime"
                                                        Click="OnPlayGentleChimeClick"
                                                        Style="{StaticResource ModernActionButtonStyle}"
                                                        Margin="0,0,8,4" />
                                                <Button Content="Reset Welcome"
                                                        Click="OnShowWelcomeScreenClick"
                                                        Style="{StaticResource ModernActionButtonStyle}"
                                                        Margin="0,0,0,4" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================================================================== -->
                <!-- VIEW 4: ABOUT & LICENSE SUB-PAGE                                      -->
                <!-- ===================================================================== -->
                <ScrollViewer x:Name="AboutDedicatedViewPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <Border Background="{DynamicResource GlassCardBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="24,20"
                            Effect="{StaticResource FluentGlassShadow}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <Button Content="← Back to Dashboard"
                                        Click="OnNavigateOverviewClick"
                                        Style="{StaticResource ModernActionButtonStyle}"
                                        Margin="0,0,16,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="About KIRON PROHORI &amp; Open Security Architecture"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock x:Name="UacStatusText"
                                               Text="Telemetry: OFF (Local-Only) · Privacy-First Windows 10 &amp; 11 (x64) Companion"
                                               FontSize="11.5"
                                               Foreground="#059669" />
                                </StackPanel>
                            </DockPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="84"
                                        Height="84"
                                        CornerRadius="20"
                                        Background="#1F10B981"
                                        BorderBrush="#4010B981"
                                        BorderThickness="1"
                                        VerticalAlignment="Top"
                                        Margin="0,0,22,0"
                                        Effect="{StaticResource FluentGlassShadow}">
                                    <Image Source="pack://application:,,,/Assets/kp-logo.png"
                                           Width="64"
                                           Height="64"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True"
                                           UseLayoutRounding="True" />
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="KIRON PROHORI — Windows Security &amp; Antivirus V1.0"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="Developer &amp; Architect: ARIFUZZAMAN KIRON · Target Platform: Windows 10 &amp; Windows 11 (x64)"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#0284C7"
                                               Margin="0,4,0,14" />

                                    <Border Background="{DynamicResource GlassElevatedBrush}"
                                            BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16"
                                            Margin="0,0,0,12">
                                        <TextBlock x:Name="AboutOfficialMessageBlock"
                                                   Text="KIRON PROHORI is an independent security application designed to help protect Windows computers through intelligent threat detection, malware scanning and security monitoring.&#x0a;&#x0a;Thank you for choosing KIRON PROHORI.&#x0a;&#x0a;Your privacy matters. Your security matters. Your trust matters.&#x0a;&#x0a;Built with care for a safer digital world."
                                                   FontSize="13"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20" />
                                    </Border>

                                    <TextBlock x:Name="AboutNonAffiliationBlock"
                                               Text="Non-Affiliation Notice: KIRON PROHORI is an independent product developed by ARIFUZZAMAN KIRON and is not affiliated with Microsoft, Kaspersky, ESET, Malwarebytes, Norton, McAfee, or other antivirus vendors."
                                               FontSize="11.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- ===================================================================== -->
                <!-- VIEW 5: FIRST-RUN LIGHT MINIMAL GLASS WELCOME OVERLAY                 -->
                <!-- ===================================================================== -->
                <Border x:Name="FirstRunWelcomeOverlayPanel"
                        Visibility="Collapsed"
                        Background="{DynamicResource AppCanvasBrush}"
                        CornerRadius="14"
                        Padding="32">
                    <Border MaxWidth="620"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource GlassCardBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="18"
                            Padding="36,30"
                            Effect="{StaticResource FluentGlassShadow}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="78"
                                    Height="78"
                                    CornerRadius="20"
                                    Background="#1F10B981"
                                    BorderBrush="#4010B981"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,16"
                                    Effect="{StaticResource FluentGlassShadow}">
                                <Image Source="pack://application:,,,/Assets/kp-logo.png"
                                       Width="58"
                                       Height="58"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="True"
                                       UseLayoutRounding="True" />
                            </Border>

                            <TextBlock Text="Welcome to KIRON PROHORI"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center" />

                            <TextBlock Text="Windows 10 &amp; Windows 11 (x64) Security Companion · By ARIFUZZAMAN KIRON"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="#0284C7"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,18" />

                            <Border Background="{DynamicResource GlassElevatedBrush}"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="18,14"
                                    Margin="0,0,0,22">
                                <StackPanel>
                                    <TextBlock Text="✓  Zero Telemetry by Default — No personal files or browsing history ever leave your PC."
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="✓  Coexists with Microsoft Defender — Never disables Windows Defender or Windows Firewall."
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="✓  Quarantine-First Policy — Isolates threats safely; permanent deletion always requires your consent."
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </StackPanel>
                            </Border>

                            <Button x:Name="WelcomeGetStartedBtn"
                                    Content="Get Started"
                                    Click="OnDismissWelcomeGetStartedClick"
                                    Style="{StaticResource PrimaryFluentCtaButtonStyle}"
                                    Padding="36,12"
                                    FontSize="14"
                                    HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Border>

            </Grid>

            <!-- ========================================================================= -->
            <!-- ROW 2: CLEAN BOTTOM UTILITY BAR (SETTINGS GEAR, NOTIFICATIONS, ABOUT)     -->
            <!-- ========================================================================= -->
            <Border Grid.Row="2"
                    Background="{DynamicResource UtilityBarBackgroundBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10"
                    Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Bottom-Left: Settings Gear Icon, Notifications Bell Icon, About/License Link -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="NavSettingsBtn"
                                Content="⚙ Settings"
                                Click="OnSettingsViewClick"
                                Style="{StaticResource ModernActionButtonStyle}"
                                Padding="11,5"
                                Margin="0,0,8,0" />
                        <Button x:Name="NavNotificationsBtn"
                                Content="🔔 Notifications"
                                Click="OnNotificationsViewClick"
                                Style="{StaticResource ModernActionButtonStyle}"
                                Padding="11,5"
                                Margin="0,0,8,0" />
                        <Button x:Name="NavAboutBtn"
                                Content="ℹ About &amp; License"
                                Click="OnAboutViewClick"
                                Style="{StaticResource ModernActionButtonStyle}"
                                Padding="11,5" />
                    </StackPanel>

                    <!-- Center: Live Status Message -->
                    <TextBlock x:Name="StatusFooterText"
                               Grid.Column="1"
                               Text="Ready · Click any glass tile to inspect or run a Quick Scan."
                               FontSize="11.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="16,0" />

                    <!-- Bottom-Right: Signature Tagline -->
                    <TextBlock Grid.Column="2"
                               Text="KIRON PROHORI v1.0 · Free Forever · Zero Telemetry"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#059669"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
