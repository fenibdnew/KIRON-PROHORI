<Window x:Class="KironProhori.Agent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KIRON PROHORI V1.0 — Windows Security &amp; Antivirus (Developer: ARIFUZZAMAN KIRON)"
        Height="880"
        Width="1380"
        MinHeight="720"
        MinWidth="1120"
        Background="#0B0F17"
        Foreground="#F3F4F6"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar: V1.0 Complete Navigation Views -->
        <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,1,0" Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock x:Name="AppTitleBlock" Text="KIRON PROHORI" FontSize="19" FontWeight="Bold" Foreground="#F9FAFB" />
                    <TextBlock x:Name="AppSubtitleBlock" Text="Windows Security &amp; Antivirus V1.0" FontSize="11" Foreground="#38BDF8" Margin="0,3,0,0" />
                    <TextBlock Text="Developer: ARIFUZZAMAN KIRON · $0 · NO TELEMETRY" FontSize="10" Foreground="#10B981" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Bottom Language, Theme & Sound Controls -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button x:Name="LanguageToggleButton"
                            Content="Language: EN / বাংলা"
                            Click="OnToggleLanguageClick"
                            Background="#1F2937"
                            Foreground="#E5E7EB"
                            BorderBrush="#374151"
                            Padding="10,7"
                            Margin="0,0,0,6" />
                    <Button x:Name="ThemeToggleButton"
                            Content="Theme: Obsidian Dark / Slate Light"
                            Click="OnToggleThemeClick"
                            Background="#1F2937"
                            Foreground="#E5E7EB"
                            BorderBrush="#374151"
                            Padding="10,7" />
                </StackPanel>

                <!-- V1.0 Navigation Views -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button x:Name="NavOverviewBtn" Content="01. Dashboard" Click="OnNavigateOverviewClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#1E293B" Foreground="#F9FAFB" />
                        <Button x:Name="NavQuickScanBtn" Content="02. Quick Scan" Click="OnQuickScanClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#111827" Foreground="#D1D5DB" />
                        <Button x:Name="NavFullScanBtn" Content="03. Full Scan" Click="OnFullScanClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#111827" Foreground="#D1D5DB" />
                        <Button x:Name="NavCustomScanBtn" Content="04. Custom Scan" Click="OnCustomScanClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#111827" Foreground="#D1D5DB" />
                        <Button x:Name="NavUsbScanBtn" Content="05. USB Scan" Click="OnUsbScanClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#111827" Foreground="#D1D5DB" />
                        <Button x:Name="NavWebProtectionBtn" Content="06. Web Protection (Chrome/Edge)" Click="OnWebProtectionViewClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#111827" Foreground="#D1D5DB" />
                        <Button x:Name="NavDownloadProtectionBtn" Content="07. Download Protection" Click="OnDownloadProtectionViewClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#111827" Foreground="#D1D5DB" />
                        <Button x:Name="NavRealtimeBtn" Content="08. Real-Time Protection" Click="OnRealtimeGuardToggleClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#111827" Foreground="#D1D5DB" />
                        <Button x:Name="NavHistoryBtn" Content="09. Threat History" Click="OnThreatHistoryClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#111827" Foreground="#D1D5DB" />
                        <Button x:Name="NavQuarantineBtn" Content="10. Quarantine" Click="OnRefreshQuarantineClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#111827" Foreground="#D1D5DB" />
                        <Button x:Name="NavExclusionsBtn" Content="11. Exclusions" Click="OnExclusionsViewClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#111827" Foreground="#D1D5DB" />
                        <Button x:Name="NavSecurityIntelBtn" Content="12. Security Intelligence" Click="OnSecurityIntelligenceViewClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#111827" Foreground="#D1D5DB" />
                        <Button x:Name="NavDefenderBtn" Content="13. Microsoft Defender Status" Click="OnRefreshWindowsSecurityClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#111827" Foreground="#D1D5DB" />
                        <Button x:Name="NavFirewallBtn" Content="14. Firewall Status" Click="OnFirewallViewClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#111827" Foreground="#D1D5DB" />
                        <Button x:Name="NavUpdatesBtn" Content="15. Updates" Click="OnCheckUpdatesClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#111827" Foreground="#D1D5DB" />
                        <Button x:Name="NavNotificationsBtn" Content="16. Notifications" Click="OnNotificationsViewClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#111827" Foreground="#D1D5DB" />
                        <Button x:Name="NavSettingsBtn" Content="17. Settings" Click="OnSettingsViewClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#111827" Foreground="#D1D5DB" />
                        <Button x:Name="NavAboutBtn" Content="18. About" Click="OnAboutViewClick" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Left" Background="#111827" Foreground="#38BDF8" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Workspace Content -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Action Bar with Pause/Resume/Cancel, EICAR Test, Exclusions, Chime & Diagnostics -->
            <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" Padding="16" Margin="0,0,0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock x:Name="CurrentSectionTitle" Text="01. Security Overview — Privacy-First Windows Companion" FontSize="17" FontWeight="SemiBold" Foreground="#F9FAFB" />
                        <TextBlock x:Name="DisclosureBannerText"
                                   Text="User-Mode Windows Companion · Coexists with Microsoft Defender · No Automatic File Upload · No Telemetry by Default"
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="PauseResumeScanBtn"
                                Content="Pause Scan"
                                Click="OnPauseResumeScanClick"
                                Background="#1E293B"
                                Foreground="#FBBF24"
                                BorderBrush="#F59E0B"
                                Padding="10,7"
                                Margin="0,0,8,0" />
                        <Button x:Name="CancelScanBtn"
                                Content="Stop Scan"
                                Click="OnCancelScanClick"
                                Background="#3F1D24"
                                Foreground="#FCA5A5"
                                BorderBrush="#EF4444"
                                Padding="10,7"
                                Margin="0,0,8,0" />
                        <Button x:Name="RunEicarSelfTestBtn"
                                Content="Run Safe EICAR Self-Test"
                                Click="OnRunEicarSelfTestClick"
                                Background="#0284C7"
                                Foreground="#FFFFFF"
                                Padding="12,7"
                                Margin="0,0,8,0" />
                        <Button x:Name="TestGentleChimeBtn"
                                Content="Play Gentle Chime"
                                Click="OnPlayGentleChimeClick"
                                Background="#065F46"
                                Foreground="#A7F3D0"
                                Padding="10,7" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Telemetry Strip: Windows Defender, Firewall, Active Exclusions, Diagnostics & Scan Progress -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="WINDOWS DEFENDER &amp; ADMIN" FontSize="10" Foreground="#9CA3AF" FontWeight="Bold" />
                        <TextBlock x:Name="DefenderStatusText" Text="Checking WMI..." FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0" />
                        <TextBlock x:Name="SignatureVersionText" Text="Signature: --" FontSize="11" Foreground="#9CA3AF" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="FIREWALL &amp; PRIVACY POSTURE" FontSize="10" Foreground="#9CA3AF" FontWeight="Bold" />
                        <TextBlock x:Name="FirewallStatusText" Text="Domain/Private/Public: --" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,5,0,0" />
                        <TextBlock x:Name="UacStatusText" Text="Telemetry: OFF (Local-Only)" FontSize="11" Foreground="#10B981" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="SCAN ENGINE &amp; THROTTLE" FontSize="10" Foreground="#9CA3AF" FontWeight="Bold" />
                        <TextBlock x:Name="ScanStateText" Text="IDLE (Balanced Profile)" FontSize="14" FontWeight="Bold" Foreground="#F9FAFB" Margin="0,5,0,0" />
                        <TextBlock x:Name="ScanMetricsText" Text="0 scanned · 0 detections · 0 skipped" FontSize="11" Foreground="#9CA3AF" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <TextBlock Text="QUARANTINE &amp; EXCLUSIONS" FontSize="10" Foreground="#9CA3AF" FontWeight="Bold" />
                        <TextBlock x:Name="QuarantineCountText" Text="0 Quarantined · 0 Excluded" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" Margin="0,5,0,0" />
                        <TextBlock x:Name="DiagnosticsHealthText" Text="Diagnostics: Healthy (.known_good ready)" FontSize="11" Foreground="#10B981" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Split Findings & Multi-Function Inspector Table -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Left Table: Detection Findings with 4-Tier Verdict & 5 Remediation Actions -->
                <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" Padding="14" Margin="0,0,12,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="SCAN DETECTIONS (CONFIRMED / SUSPICIOUS / UNKNOWN / CLEAN)"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#E5E7EB"
                                       VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Quarantine (Recommended)"
                                        Click="OnQuarantineSelectedFindingClick"
                                        Background="#B45309"
                                        Foreground="#FFFFFF"
                                        Padding="9,4"
                                        Margin="0,0,6,0" />
                                <Button Content="Ignore Once"
                                        Click="OnIgnoreSelectedFindingOnceClick"
                                        Background="#1F2937"
                                        Foreground="#D1D5DB"
                                        Padding="9,4"
                                        Margin="0,0,6,0" />
                                <Button Content="Add Exclusion"
                                        Click="OnExcludeSelectedFindingClick"
                                        Background="#1E293B"
                                        Foreground="#38BDF8"
                                        Padding="9,4" />
                            </StackPanel>
                        </DockPanel>
                        <ListBox x:Name="FindingsListBox"
                                 Background="#0B0F17"
                                 Foreground="#E5E7EB"
                                 BorderBrush="#1F2937"
                                 FontFamily="Consolas"
                                 FontSize="12" />
                    </DockPanel>
                </Border>

                <!-- Right Panel: Quarantine Vault, Exclusions & About Summary -->
                <Border Grid.Column="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" Padding="14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock x:Name="RightPanelHeaderText"
                                       Text="AES-256-GCM QUARANTINE VAULT &amp; EXCLUSIONS"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#E5E7EB"
                                       VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Restore Selected"
                                        Click="OnRestoreSelectedQuarantineClick"
                                        Background="#065F46"
                                        Foreground="#FFFFFF"
                                        Padding="8,4"
                                        Margin="0,0,6,0" />
                                <Button Content="Permanent Delete"
                                        Click="OnDeleteSelectedQuarantineClick"
                                        Background="#7F1D1D"
                                        Foreground="#FCA5A5"
                                        Padding="8,4" />
                            </StackPanel>
                        </DockPanel>
                        <ListBox x:Name="QuarantineListBox"
                                 Background="#0B0F17"
                                 Foreground="#E5E7EB"
                                 BorderBrush="#1F2937"
                                 FontFamily="Consolas"
                                 FontSize="12" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="3" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" Padding="12,8" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock x:Name="StatusFooterText"
                               Text="Ready · KIRON PROHORI Windows Security &amp; Antivirus · Developer: ARIFUZZAMAN · Cloud Sync: OFF by Default"
                               FontSize="11"
                               Foreground="#9CA3AF" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="SHA-256 · Heuristic PE · YARA · ClamAV · Defender Coexistence"
                               FontSize="11"
                               Foreground="#38BDF8"
                               HorizontalAlignment="Right" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
